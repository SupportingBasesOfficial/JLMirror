{
  "cli": {
    "version": ">= 12.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "node": "22.14.0",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://drum-bracket-money-discovered.trycloudflare.com/api/v1",
        "EXPO_PUBLIC_WS_URL": "wss://drum-bracket-money-discovered.trycloudflare.com/ws"
      }
    },
    "apk": {
      "distribution": "internal",
      "channel": "apk",
      "node": "22.14.0",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://drum-bracket-money-discovered.trycloudflare.com/api/v1",
        "EXPO_PUBLIC_WS_URL": "wss://drum-bracket-money-discovered.trycloudflare.com/ws"
      }
    },
    "staging": {
      "distribution": "internal",
      "channel": "staging",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://staging-api.jlmirror.com/api/v1",
        "EXPO_PUBLIC_WS_URL": "wss://staging-api.jlmirror.com/ws"
      }
    },
    "production": {
      "channel": "production",
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_API_URL": "https://api.jlmirror.com/api/v1",
        "EXPO_PUBLIC_WS_URL": "wss://api.jlmirror.com/ws"
      }
    }
  }
}
