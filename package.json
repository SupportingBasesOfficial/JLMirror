{
  "name": "@jlinformatica/jlmirror",
  "version": "1.0.0",
  "description": "JLMIRROR — Portal de Monitoramento Multi-tenant. Arquitetura Next.js + Hono + PostgreSQL.",
  "author": "JLInformatica",
  "license": "MIT",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "test": "vitest",
    "test:run": "vitest run",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "e2e:ci": "CI=true playwright test",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "analyze": "ANALYZE=true pnpm build",
    "prepare": "husky",
    "clean": "rimraf **/node_modules **/.next **/dist .turbo",
    "db:migrate": "tsx -r dotenv/config packages/db/src/migrate.ts up",
    "db:migrate:down": "tsx packages/db/src/migrate.ts down",
    "db:seed": "tsx scripts/seed-monitoring.ts",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "gen:page": "node scripts/gen-page.mjs",
    "gen:component": "node scripts/gen-component.mjs",
    "gen:api": "node scripts/gen-api.mjs",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "pnpm version-packages && pnpm publish -r"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.0",
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@next/bundle-analyzer": "^16.3.2",
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.5",
    "@types/node": "^22.10.5",
    "@types/pg": "^8.23.1",
    "@vitest/coverage-v8": "^4.1.11",
    "@vitest/ui": "^4.1.11",
    "argon2": "^0.45.1",
    "babel-plugin-react-compiler": "^1.0.0",
    "dotenv": "^16.4.7",
    "eslint": "9",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "lint-staged": "^17.3.0",
    "next": "^16.3.2",
    "next-themes": "^0.4.6",
    "node-pg-migrate": "^7.9.1",
    "pg": "^8.23.0",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.9.6",
    "rimraf": "^6.1.3",
    "tsx": "^4.23.12",
    "turbo": "^2.10.11",
    "typescript": "5.9.2",
    "vite": "^6.3.5",
    "vitest": "^4.1.11",
    "@repo/typescript-config": "workspace:*"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "pnpm eslint --max-warnings 0 --no-warn-ignored",
      "pnpm prettier --write"
    ],
    "*.{json,md,css}": [
      "pnpm prettier --write"
    ]
  },
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "pino": "^10.3.1"
  }
}
