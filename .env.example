# === DATABASE ===
POSTGRES_PASSWORD=
DATABASE_URL=postgresql://postgres:${POSTGRES_PASSWORD}@localhost:5432/jlmirror
# Master (escrita) — se diferente de DATABASE_URL
DATABASE_MASTER_URL=postgresql://postgres:${POSTGRES_PASSWORD}@localhost:5432/jlmirror
# Réplica (leitura) — opcional, melhora throughput de reads
# DATABASE_REPLICA_URL=postgresql://postgres:${POSTGRES_PASSWORD}@postgres-replica:5432/jlmirror
# Shards adicionais (opcional — para sharding funcional multi-cluster)
# DATABASE_SHARD_1_URL=postgresql://postgres:${POSTGRES_PASSWORD}@shard-1:5432/jlmirror
# DATABASE_SHARD_2_URL=postgresql://postgres:${POSTGRES_PASSWORD}@shard-2:5432/jlmirror
# Pool max connections — default 50. Com PgBouncer, usar valor menor (ex: 10)
DB_POOL_MAX=50

# === REDIS ===
REDIS_URL=redis://localhost:6379

# === JWT (RS256) ===
# Gere com: node scripts/generate-keys.mjs
# Suporta PEM direto ou base64-encoded PEM
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
JWT_ACCESS_TOKEN_TTL_MINUTES=15
JWT_REFRESH_TOKEN_TTL_DAYS=30
JWT_ISSUER=jl-informatica-portal
JWT_AUDIENCE=jl-portal-api

# === ZABBIX ===
ZABBIX_ENCRYPTION_KEY_HEX=
ENCRYPTION_KEY=
ZABBIX_API_URL=https://zabbix.jlinformatica.com.br/api_jsonrpc.php

# === LDAP (opcional) ===
# Instalar ldapjs: pnpm add ldapjs @types/ldapjs
# LDAP_URL=ldap://ldap.jlinformatica.com.br:389
# LDAP_BIND_DN=cn=admin,dc=jlinformatica,dc=com,dc=br
# LDAP_BIND_PASSWORD=
# LDAP_SEARCH_BASE=ou=users,dc=jlinformatica,dc=com,dc=br

# === OAUTH GOOGLE (opcional) ===
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3001/api/v1/auth/oauth/google/callback

# === SMTP / EMAIL (opcional) ===
# Instalar nodemailer: pnpm add nodemailer @types/nodemailer
# SMTP_HOST=smtp.jlinformatica.com.br
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=noreply@jlinformatica.com.br

# === CORS ===
# Lista de origens permitidas separadas por vírgula
CORS_ALLOWED_ORIGINS=http://localhost:3000

# === API DOCS (opcional) ===
# Protege /api/v1/docs e /api/v1/docs/ui com Basic Auth
# DOCS_PASSWORD=sua-senha-forte-aqui

# === API ===
API_PORT=3001
API_URL=http://localhost:3001
API_INTERNAL_URL=http://localhost:3001

# === FRONTEND ===
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_WS_URL=ws://localhost:3001/ws

# === SENTRY (opcional) ===
# SENTRY_DSN=
# NEXT_PUBLIC_SENTRY_DSN=

# === MISC ===
NODE_ENV=development

# === LOGGING / TRACING ===
# Nivel de log (debug, info, warn, error)
LOG_LEVEL=info
# Taxa de amostragem para log ingestion (0.0 a 1.0)
LOG_SAMPLE_RATE=1.0
# Nome do servico para OpenTelemetry traces
SERVICE_NAME=jlmirror-api

# === SEGURANCA ===
# BYPASS_PERMISSIONS=true bypassa todo RBAC — NUNCA usar em producao
# Apenas para testes automatizados
# BYPASS_PERMISSIONS=false

# === WEB PUSH (VAPID) ===
# Gerar com: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@jlinformatica.com.br
