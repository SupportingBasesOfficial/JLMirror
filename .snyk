# Snyk (https://snyk.io) policy file — JLMIRROR
# Exclui arquivos nao-produtivos da analise Snyk Code

exclude:
  code:
    # Ferramentas dev internas
    - .zero-error/**
    # Scripts de code generation
    - scripts/**
    # Service Worker (origin validation ja implementada)
    - apps/web/public/sw.js
    # Testes unitarios (fixtures, nao credenciais reais)
    - "**/*.test.ts"
    - "**/*.spec.ts"
    # E2E tests
    - e2e/**
